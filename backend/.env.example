# ==================== SUPABASE ====================
# ⚠️ NE JAMAIS COMMITER .env — utiliser ce fichier comme modèle
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ==================== APP ====================
APP_NAME=Job Africa API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==================== COLLECTE ====================
COLLECT_INTERVAL_HOURS=6
REQUEST_TIMEOUT=15
MAX_JOBS_PER_SOURCE=200

# ==================== PUSH (VAPID) ====================
# Générer avec : python -c "from py_vapid import Vapid; Vapid().generate_keys()"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@jobafrica.app

# ==================== KKIAPAY ====================
# Sandbox d'abord, puis live
PAYMENT_PROVIDER=kkiapay
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true
